# Postgres konekcija (lokalno: docker compose up -d)
DATABASE_URL=postgres://furlada:furlada@localhost:5434/furlada

# Better Auth — secret generisati sa: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin nalog koji pravi seed skripta (npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
